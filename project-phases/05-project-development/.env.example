# Required for real Gemini generation
GEMINI_API_KEY=your_gemini_api_key_here

# Current defaults. Change if your Google AI account uses different models.
GEMINI_WORKOUT_MODEL=gemini-3.8-flash
GEMINI_TIP_MODEL=gemini-3.8-flash

# Admin / session settings
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-this-to-a-long-random-secret

# Optional tuning
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=5000
DATABASE_URL=sqlite:///./fitbuddy.db
